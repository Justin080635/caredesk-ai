rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CareDesk AI persists all multi-tenant clinic records in its Express/SQLite backend
    // protected by Firebase Auth ID token verification and clinic-level RBAC.
    // Direct client Firestore reads and writes are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
